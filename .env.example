# Crawllex env template (committed). Copy to `.env.local` for development.
# Production uses `.env.production.local` (gitignored) + Hostinger env — same keys,
# same shared secrets; only MONGODB_URI and APP_URL / FRONTEND_URL differ.
#
# Files we keep (only these three):
#   .env.example              ← this file (template)
#   .env.local                ← local / development
#   .env.production.local     ← production seed + Hostinger mirror
#
# Seed:
#   npm run seed       → .env.local
#   npm run seed:prod  → .env.production.local

# MongoDB
# Local example: mongodb://127.0.0.1:27017/seo-dashboard
# Atlas SRV: mongodb+srv://USER:PASS@cluster.mongodb.net/seo-dashboard?retryWrites=true&w=majority
# Atlas DIRECT (Windows querySrv issues): mongodb://USER:PASS@host1:27017,.../seo-dashboard?ssl=true&replicaSet=...&authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/seo-dashboard

# App
APP_NAME=Crawllex
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_KEY=base64:changeme-generate-with-openssl-rand-base64-32

# Auth
BCRYPT_ROUNDS=12
SUPER_ADMIN_EMAIL=admin@crawllex.com
SUPER_ADMIN_PASSWORD=changeme

PASSWORD_RESET_EXPIRE=60
PASSWORD_RESET_THROTTLE=60
EMAIL_VERIFICATION_EXPIRE=60

# Mail — Zoho SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=admin@crawllex.com
MAIL_FROM_NAME=Crawllex

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=seo-dashboard
R2_PUBLIC_BASE_URL=

# Cron
CRON_SECRET=

# Google Service Account (Module 8)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
