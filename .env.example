# MongoDB (database name may remain seo-dashboard; product brand is Crawllex)
# Local: mongodb://127.0.0.1:27017/seo-dashboard
# Atlas SRV (may fail on Windows with querySrv ECONNREFUSED — use DIRECT from Atlas Connect screen):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/seo-dashboard
# Atlas DIRECT (use if SRV fails — copy from Atlas → Connect → Drivers → "Standard connection string"):
# MONGODB_URI=mongodb://USER:PASS@host1:27017,host2:27017,host3:27017/seo-dashboard?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/seo-dashboard

# App
APP_NAME=Crawllex
# Local defaults. Production must use the public origin (no trailing slash):
# APP_URL=https://crawllex.com
# FRONTEND_URL=https://crawllex.com
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_KEY=base64:changeme-generate-with-openssl-rand-base64-32

# Auth
BCRYPT_ROUNDS=12
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=password
# After changing these, re-run `npm run seed` so MongoDB matches.
# Seed upserts this account and demotes any other leftover super_admin users.

# Cloudflare R2 (required for profile + project image uploads)
# Create a bucket in Cloudflare dashboard -> R2, then an API token scoped to it
# (R2 -> Manage API Tokens -> Create API Token -> Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

PASSWORD_RESET_EXPIRE=60
PASSWORD_RESET_THROTTLE=60
EMAIL_VERIFICATION_EXPIRE=60

# Mail — MAIL_MAILER=log writes to console; use smtp for real delivery (auth emails, etc.)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Crawllex

# Zoho Mail (personal @zohomail.com) — enable SMTP in Zoho Mail → Settings → Mail Accounts
# Use an app-specific password if 2FA is enabled (Zoho Account → Security → App Passwords).
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.zoho.com
# MAIL_PORT=587
# MAIL_USERNAME=your-account@zohomail.com
# MAIL_PASSWORD=your-app-specific-password
# MAIL_FROM_ADDRESS=your-account@zohomail.com

# Cron — protect nightly analytics sync (`GET|POST /api/v1/cron/analytics-sync`)
# Authorization: Bearer <CRON_SECRET>  or  x-cron-secret: <CRON_SECRET>
CRON_SECRET=

# Google Service Account (Module 8 — GSC + GA4)
# Enable Search Console API + Google Analytics Data API + Analytics Admin API in GCP, then either:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# or:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=seo-sync@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
